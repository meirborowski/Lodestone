# Enforces the naming rules in docs/CodeStyle.md and catches common bugs. Pinned to the clang-tidy version in
# tools/requirements.txt. Keep this file and the doc in agreement.
#
# Checks that are turned off, and why:
#   bugprone-easily-swappable-parameters          flags nearly every function with two parameters of one type (x, y)
#   bugprone-invalid-enum-default-initialization  flags zero-initialized Vulkan structs, whose API defines zero as valid
#   clang-analyzer-optin.core.EnumCastOutOfRange  flags every combination of flag enum values (EnumFlags.h), including
#                                                 the standard library's
#   misc-include-cleaner                          doesn't understand umbrella headers such as spdlog's bundled fmt
#   misc-misplaced-const                          Vulkan handles are pointer typedefs: `const VkDevice` is meant to be a
#                                                 const handle, as misc-const-correctness asks
#   misc-no-recursion                             recursion is the clearest way to walk trees such as scene hierarchies
#   misc-non-private-member-variables-in-classes  plain structs (components, configs) have public members by design
#   modernize-use-trailing-return-type            the style uses leading return types
#   modernize-use-nodiscard                       [[nodiscard]] marks results that must be checked, not every getter
#   modernize-avoid-c-arrays                      C APIs and generated data (embedded shaders) use C arrays
#   modernize-macro-to-enum                       configuration macros must stay macros, for #if
#   performance-enum-size                         enums keep the default underlying type unless their size matters
#   portability-avoid-pragma-once                 the style uses #pragma once
#   readability-braces-around-statements          the style allows single-statement bodies without braces
#   readability-convert-member-functions-to-static  flags members that don't use state yet, which is an API choice
#   readability-else-after-return                 an else after a return can read better
#   readability-function-cognitive-complexity     complexity is judged in review
#   readability-identifier-length                 short names (x, y, i) are fine where they're conventional
#   readability-implicit-bool-conversion          `if (pointer)` and `if (expected)` are idiomatic
#   readability-magic-numbers                     constants in math and tests read better inline
#   readability-math-missing-parentheses          standard operator precedence in math doesn't need parentheses
#   readability-redundant-access-specifiers       the style repeats `private:` to separate functions from members
#   readability-uppercase-literal-suffix          the style writes 1.0f
#   readability-use-concise-preprocessor-directives  the style writes #if defined(X) throughout
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-invalid-enum-default-initialization,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  concurrency-*,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  misc-*,
  -misc-include-cleaner,
  -misc-misplaced-const,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays,
  -modernize-macro-to-enum,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-else-after-return,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-redundant-access-specifiers,
  -readability-uppercase-literal-suffix,
  -readability-use-concise-preprocessor-directives
WarningsAsErrors: '*'
# Only Lodestone's own headers; build trees (generated files, fetched dependencies) are excluded
HeaderFilterRegex: '.*[/\\](Source|Tests|Samples)[/\\].*'
ExcludeHeaderFilterRegex: '.*[/\\](build|_deps)[/\\].*'
SystemHeaders: false
FormatStyle: none
CheckOptions:
  # Types, functions and methods: PascalCase
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  # Local variables and parameters: camelCase
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ConstantParameterCase: camelBack
  # Private and protected member variables: m_ + PascalCase. Public data members (plain structs) are PascalCase
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: CamelCase
  readability-identifier-naming.PublicMemberCase: CamelCase
  # Static variables: s_ + PascalCase; globals: g_ + PascalCase. clang-tidy treats namespace-scope variables with
  # internal linkage as globals, so those accept either prefix
  readability-identifier-naming.ClassMemberPrefix: s_
  readability-identifier-naming.ClassMemberCase: CamelCase
  readability-identifier-naming.StaticVariablePrefix: s_
  readability-identifier-naming.StaticVariableCase: CamelCase
  readability-identifier-naming.GlobalVariablePrefix: g_
  readability-identifier-naming.GlobalVariableCase: CamelCase
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '^s_[A-Z][A-Za-z0-9]*$'
  # Constants at namespace and class scope, and static local constants: PascalCase. Local constants are camelCase
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.StaticConstantCase: CamelCase
  # Macros: UPPER_SNAKE_CASE with an LS_ prefix. Third-party configuration macros keep their own names
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionPrefix: LS_
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^(DOCTEST|SOL|SPDLOG|FMT|GLM|JPH|IMGUI|NOMINMAX|WIN32|ENTT|JSON)_?.*$'
  # Allow the C++ standard's spelling where an interface requires it (format_as, begin/end, ...)
  readability-identifier-naming.FunctionIgnoredRegexp: '^(format_as|begin|end|swap|hash)$'
  readability-identifier-naming.MethodIgnoredRegexp: '^(begin|end|swap|size|empty|data)$'
  misc-const-correctness.AnalyzeValues: true
  misc-const-correctness.WarnPointersAsValues: false
  bugprone-unchecked-optional-access.IgnoreSmartPointerDereference: true
