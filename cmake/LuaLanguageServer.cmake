# lua-language-server (LuaLS) - type-checks the test and sample scripts against the annotations the engine generates
# from its bindings (see docs/Decisions/0022-scripting.md). Pinned in tools/luals.env, downloaded for the host,
# verified against the release's hash and kept in LS_LUALS_CACHE_DIR, like lavapipe.
#
# Sets LS_LUALS_EXECUTABLE to the server, or LS_LUALS_UNAVAILABLE_REASON when there's none.

option(LS_REQUIRE_LUA_LANGUAGE_SERVER "Fail to configure when lua-language-server isn't available, instead of skipping the script type check (CI sets this)" OFF)
set(LS_LUALS_CACHE_DIR "${PROJECT_SOURCE_DIR}/.cache/luals" CACHE PATH "Directory where lua-language-server is installed")

file(STRINGS "${PROJECT_SOURCE_DIR}/tools/luals.env" LS_LUALS_SETTINGS REGEX "^[A-Z_0-9]+=")
foreach(setting IN LISTS LS_LUALS_SETTINGS)
	string(REGEX MATCH "^([A-Z_0-9]+)=(.*)$" _ "${setting}")
	set(LS_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
endforeach()

set(LS_LUALS_EXECUTABLE "")
set(LS_LUALS_UNAVAILABLE_REASON "")

# The release asset for the host
set(platform "")
if(CMAKE_HOST_WIN32 AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(AMD64|x86_64)$")
	set(platform "win32-x64")
	set(extension "zip")
	set(hash "${LS_LUALS_WINDOWS_X64_SHA256}")
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$")
	set(platform "linux-x64")
	set(extension "tar.gz")
	set(hash "${LS_LUALS_LINUX_X64_SHA256}")
elseif(CMAKE_HOST_APPLE AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
	set(platform "darwin-arm64")
	set(extension "tar.gz")
	set(hash "${LS_LUALS_MACOS_ARM64_SHA256}")
elseif(CMAKE_HOST_APPLE AND CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "x86_64")
	set(platform "darwin-x64")
	set(extension "tar.gz")
	set(hash "${LS_LUALS_MACOS_X64_SHA256}")
else()
	set(LS_LUALS_UNAVAILABLE_REASON "lua-language-server has no release for ${CMAKE_HOST_SYSTEM_NAME} on ${CMAKE_HOST_SYSTEM_PROCESSOR}")
endif()

if(platform)
	set(installDirectory "${LS_LUALS_CACHE_DIR}/${LS_LUALS_VERSION}-${platform}")
	set(executable "${installDirectory}/bin/lua-language-server${CMAKE_HOST_EXECUTABLE_SUFFIX}")
	if(NOT EXISTS "${executable}")
		set(archive "${LS_DEPENDENCY_CACHE_DIR}/luals-${hash}.${extension}")
		set(url "https://github.com/LuaLS/lua-language-server/releases/download/${LS_LUALS_VERSION}/lua-language-server-${LS_LUALS_VERSION}-${platform}.${extension}")
		set(archiveHash "")
		if(EXISTS "${archive}")
			file(SHA256 "${archive}" archiveHash)
		endif()
		if(NOT archiveHash STREQUAL hash)
			message(STATUS "Downloading lua-language-server ${LS_LUALS_VERSION}")
			file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH SHA256=${hash} STATUS status)
			list(GET status 0 statusCode)
			if(NOT statusCode EQUAL 0)
				file(REMOVE "${archive}")
				set(LS_LUALS_UNAVAILABLE_REASON "lua-language-server couldn't be downloaded from ${url}: ${status}")
			endif()
		endif()
		if(NOT LS_LUALS_UNAVAILABLE_REASON)
			file(REMOVE_RECURSE "${installDirectory}.partial")
			file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${installDirectory}.partial")
			file(RENAME "${installDirectory}.partial" "${installDirectory}")
		endif()
	endif()
	if(EXISTS "${executable}")
		set(LS_LUALS_EXECUTABLE "${executable}")
	elseif(NOT LS_LUALS_UNAVAILABLE_REASON)
		set(LS_LUALS_UNAVAILABLE_REASON "lua-language-server's archive has no ${executable}")
	endif()
endif()

if(LS_LUALS_EXECUTABLE)
	message(STATUS "lua-language-server ${LS_LUALS_VERSION}: ${LS_LUALS_EXECUTABLE}")
elseif(LS_REQUIRE_LUA_LANGUAGE_SERVER)
	message(FATAL_ERROR "LS_REQUIRE_LUA_LANGUAGE_SERVER is on, but ${LS_LUALS_UNAVAILABLE_REASON}")
else()
	message(STATUS "The script type check will be skipped: ${LS_LUALS_UNAVAILABLE_REASON}")
endif()
