# The pinned lavapipe (Mesa's software Vulkan driver) that reference-image tests render with. Read by
# cmake/Lavapipe.cmake, tools/build-lavapipe.sh and CI. Reference images depend on this version: updating it means
# regenerating every reference image, with the reason in the commit message (see docs/Testing.md#reference-images).
MESA_VERSION=26.2.4
# Source release, built on Linux: https://archive.mesa3d.org/mesa-26.2.4.tar.xz
MESA_SOURCE_SHA256=bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9
# Prebuilt Windows release from mesa-dist-win: mesa3d-26.2.4-release-msvc.7z
MESA_WINDOWS_ARCHIVE_SHA256=351fc8c8b695878ffb3eaa044b3ead08672a48b1a045e3c3e3975811df0f6695
# LLVM major version lavapipe is built against on Linux
LLVM_VERSION=19
